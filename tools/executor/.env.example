# Copie en .env puis adapte. Ne commite JAMAIS .env.
EXECUTOR_TOKEN=remplace-moi-par-48-caracteres-aleatoires-minimum
PORT=7788
HOST=127.0.0.1
REPO_ROOT=/chemin/absolu/vers/ton/repo
BASE_BRANCH=main

# Exécuteur : agy = Antigravity CLI (ton abonnement Google AI Pro).
AGENT_CMD=agy
# Laisse vide pour le modèle par défaut, sinon ex. "Gemini 3.1 Pro (High)"
AGENT_MODEL=
PRINT_TIMEOUT=30m
HARD_TIMEOUT=2400
JOB_TIMEOUT_MS=2700000

AUTO_PUSH=1
OPEN_PR=1
SKIP_PERMISSIONS=1
GIT_USER_NAME=antigravity-executor
GIT_USER_EMAIL=executor@local

# Suppléant si le quota hebdomadaire est épuisé : AGENT_CMD=qwen (ou opencode, aider)
